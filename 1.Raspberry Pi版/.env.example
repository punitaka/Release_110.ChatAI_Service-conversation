# .env.example
# このファイルを .env という名前でコピーして、実際のAPIキーを記入してください。
# コマンド: cp .env.example .env

# Manus API Key
# 取得先: https://manus.im/app?show_settings=integrations&app_name=api
MANUS_API_KEY=your_manus_api_key_here

# OpenAI API Key
# 取得先: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) API Key
# 取得先: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
