menu "AI Conversation (CrowPanel) Settings"

    config CONVERSATION_WIFI_SSID
        string "Wi-Fi SSID (2.4GHz)"
        default "your_wifi_ssid"
        help
            Wi-Fi network the CrowPanel connects to. The onboard ESP32-C6 supports
            2.4GHz only. The value is stored in the (git-ignored) sdkconfig, not in the source.

    config CONVERSATION_WIFI_PASSWORD
        string "Wi-Fi password"
        default "your_wifi_password"

    config CONVERSATION_PI_BASE_URL
        string "Raspberry Pi server URL"
        default "http://192.168.0.10:5000"
        help
            Base URL of the Flask server running on the Raspberry Pi (app.py),
            e.g. http://192.168.0.10:5000 . Using the Pi's IP address
            ("hostname -I" on the Pi) is recommended; mDNS names such as
            raspberrypi.local have not been tested with this firmware.

endmenu
